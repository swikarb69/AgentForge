# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit LF formatting for source code and configurations
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
