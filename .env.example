# ==============================================================================
# AgentForge Environment Configuration Template
# Target Version: 0.11.0
# Copy this file to .env and customize for your environment.
# NEVER commit your actual .env file or real API keys to version control.
# ==============================================================================

# Application Configuration
APP_NAME=AgentForge
APP_VERSION=0.11.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=

# AI Provider Configuration
# Supported providers: mock (deterministic CI default), gemini, openai
#
# Profile A: Offline / CI Default (no paid credentials required):
#   AI_PROVIDER=mock
#
# Profile B: Google Gemini Setup:
#   AI_PROVIDER=gemini
#   GEMINI_API_KEY=AIzaSy...
#   GEMINI_MODEL=gemini-1.5-pro
#
# Profile C: OpenAI Setup:
#   AI_PROVIDER=openai
#   OPENAI_API_KEY=sk-proj-...
#   OPENAI_MODEL=gpt-4o
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.2

# GitHub Integration Configuration
# For controlled release and pull-request creation (Zero Auto-Merge).
# Fine-Grained Personal Access Token (PAT) permissions required:
#   - Repository Permissions -> Contents: Read & write (for branch and commit creation)
#   - Repository Permissions -> Pull requests: Read & write (for PR creation)
#   - Repository Permissions -> Metadata: Read-only (mandatory)
# Leave GITHUB_TOKEN empty to automatically use deterministic MockReleaseProvider.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_OWNER=swikarb69
GITHUB_REPO=AgentForge

# Storage & Persistence Configuration
# Supported backends: memory, file, sqlite
DATABASE_URL=sqlite:///./agentforge.db
STORAGE_BACKEND=memory
STORAGE_DIR=agentforge-storage

# Execution Sandbox Configuration
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1
DOCKER_IMAGE=agentforge-sandbox:latest
# Secure containerized execution: use dedicated execution broker for zero-trust isolation
# When EXECUTION_BROKER_URL is set, application container has NO Docker socket or Docker CLI access.
EXECUTION_BROKER_URL=
EXECUTION_BROKER_AUTH_TOKEN=
DOCKER_PER_EXECUTION_VOLUMES=true
DOCKER_HOST=
DOCKER_CONTAINER_GATEKEEPER_ENFORCED=true
DOCKER_NAMED_VOLUME=
WORKSPACE_ROOT=agentforge-workspaces
WORKSPACE_SIZE_LIMIT=50000000
WORKSPACE_RETENTION_SECONDS=3600
EXECUTION_TIMEOUT=30
EXECUTION_MEMORY_LIMIT=512m
EXECUTION_CPU_LIMIT=1.0
EXECUTION_PROCESS_LIMIT=64
EXECUTION_NETWORK_ENABLED=false

# Repository Intelligence Limits
MAX_FILE_SIZE=1048576
MAX_FILES=10000

# Issue Intelligence Limits
MAX_ISSUE_TITLE_LENGTH=256
MAX_ISSUE_DESCRIPTION_LENGTH=65536

# Code Generation Settings
GENERATION_PROVIDER=mock
GENERATION_TIMEOUT=60
MAX_CONTEXT_SIZE=100000
MAX_GENERATED_OUTPUT=100000
MAX_FILES_PER_REQUEST=10
MAX_TASKS_PER_REQUEST=20
GENERATION_ARTIFACT_DIR=agentforge-artifacts/generation
GENERATION_RETRY_LIMIT=2

# Debugging & Automatic Repair Settings
DEBUGGING_ENABLED=true
DEBUGGING_MAX_ATTEMPTS=3
DEBUGGING_MAX_ATTEMPTS_LIMIT=5
DEBUGGING_ALLOW_PROVIDER_DIAGNOSIS=false
DEBUGGING_AUTO_EXECUTE_REPAIRS=true
DEBUGGING_MAX_EVIDENCE_BYTES=100000
DEBUGGING_MAX_TRACEBACK_LINES=50
DEBUGGING_REQUIRE_APPROVAL_FOR_HIGH_RISK=true

# Security & Release Safeguards (NON-NEGOTIABLE)
# AUTO_MERGE_ALLOWED must ALWAYS remain false (Zero Auto-Merge boundary)
AUTO_MERGE_ALLOWED=false
# HOST_EXECUTION_FALLBACK_ALLOWED must ALWAYS remain false (No host execution fallback)
HOST_EXECUTION_FALLBACK_ALLOWED=false

# Authentication and Authorization
# In production (ENVIRONMENT=production), authentication is strictly mandatory
# and cannot be disabled through Compose or environment overrides.
# API_KEY must be configured with a non-empty secret key.
API_KEY_AUTH_ENABLED=false
API_KEY=

# CORS Configuration
# Comma-separated or JSON list of allowed origins.
# In production, wildcard '*' is rejected by configuration validation.
CORS_ORIGINS=["http://localhost:3000"]
