# Application Settings
APP_NAME=AgentForge
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Future AI & GitHub Integrations (Not required for Sprint 0)
GITHUB_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Execution Sandbox Settings
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1
DOCKER_IMAGE=agentforge-sandbox:latest
WORKSPACE_ROOT=agentforge-workspaces
WORKSPACE_SIZE_LIMIT=50000000
WORKSPACE_RETENTION_SECONDS=3600
EXECUTION_TIMEOUT=30
EXECUTION_MEMORY_LIMIT=512m
EXECUTION_CPU_LIMIT=1.0
EXECUTION_PROCESS_LIMIT=64
EXECUTION_NETWORK_ENABLED=false
 
# Debugging & Automatic Repair Settings (Sprint 6)
DEBUGGING_ENABLED=true
DEBUGGING_MAX_ATTEMPTS=3
DEBUGGING_MAX_ATTEMPTS_LIMIT=5
DEBUGGING_ALLOW_PROVIDER_DIAGNOSIS=false
DEBUGGING_AUTO_EXECUTE_REPAIRS=true
DEBUGGING_MAX_EVIDENCE_BYTES=100000
DEBUGGING_MAX_TRACEBACK_LINES=50
DEBUGGING_REQUIRE_APPROVAL_FOR_HIGH_RISK=true
