# Application Settings
APP_NAME=AgentForge
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Future AI & GitHub Integrations (Not required for Sprint 0)
GITHUB_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Execution Sandbox Settings
SANDBOX_TIMEOUT=30
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1
DOCKER_IMAGE=agentforge-sandbox:latest
WORKSPACE_ROOT=agentforge-workspaces
WORKSPACE_SIZE_LIMIT=50000000
WORKSPACE_RETENTION_SECONDS=3600
EXECUTION_TIMEOUT=30
EXECUTION_MEMORY_LIMIT=512m
EXECUTION_CPU_LIMIT=1.0
EXECUTION_PROCESS_LIMIT=64
EXECUTION_MAX_OUTPUT=100000
EXECUTION_NETWORK_ENABLED=false
